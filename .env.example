# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://shopflow:shopflow@localhost:5442/shopflow
TEST_DATABASE_URL=postgres://shopflow:shopflow@localhost:5442/shopflow_test
# Any long random string; generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=3201
WEB_ORIGIN=http://localhost:5201
# Public demo (the hosted copy): one-click demo sign-in, demo accounts locked, tighter rate
# limits, and simulated trading so the dashboard's "Today" always has data. Off by default.
DEMO_PUBLIC=0
# Proxies in front of the app, for client IPs in rate limits: 1 locally, 2 behind Cloudflare + NPM.
TRUST_PROXY=1
# Container only: `if-empty` loads the demo dataset into an empty database at start.
# SEED_DEMO=if-empty
