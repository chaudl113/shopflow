# Copy to deploy/.env next to compose.vps.yml. Never commit the filled-in file.
# A dedicated database and role on the shared Postgres (the role must own the database:
# migrations create the btree_gist extension and a `drizzle` schema).
DATABASE_URL=postgres://shopflow:CHANGE_ME@postgres:5432/shopflow
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
